# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# Locally, the same values also configure the PostgreSQL container defined in compose.yaml.
# In production these variables are set in the Render dashboard instead (see README).

# JDBC URL of the database.
#   Local:    jdbc:postgresql://localhost:5433/arrima
#   Supabase: jdbc:postgresql://<session pooler host>:5432/postgres?sslmode=require
DB_URL=

# Database user. Locally any name; on Supabase it looks like postgres.<project-ref>
DB_USERNAME=

# Database password. Locally any value (avoid backslashes); on Supabase, the project's database password.
DB_PASSWORD=

# Secret that signs the session tokens: base64 of 32+ random bytes. Generate one with:
#   openssl rand -base64 32
# (On Render the Blueprint generates it by itself.)
JWT_SECRET=

# Images (production only; locally the "local" profile stores them in backend/.local-files).
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...). Never put it in the frontend.
SUPABASE_SECRET_KEY=

# Optional: bucket for the images (production only). Uncomment only to change the default.
# SUPABASE_BUCKET=arrima

# E-mail for password recovery (production only; locally the "local" profile writes it to the log).
# Brevo API key (xkeysib-...). Never put it in the frontend.
BREVO_API_KEY=
# Sender address, verified in Brevo (Senders & IP > Senders).
MAIL_SENDER_EMAIL=
# Optional: sender name. Uncomment only to change the default.
# MAIL_SENDER_NAME=Arrima
# Public address of the frontend, for the links in the e-mails, e.g. https://arrima.vercel.app
APP_URL=
