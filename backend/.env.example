# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.
# Locally, the same values also configure the PostgreSQL container defined in compose.yaml.
# In production these variables are set in the Render dashboard instead (see README).

# JDBC URL of the database.
#   Local:    jdbc:postgresql://localhost:5433/arrima
#   Supabase: jdbc:postgresql://<session pooler host>:5432/postgres?sslmode=require
DB_URL=

# Database user. Locally any name; on Supabase it looks like postgres.<project-ref>
DB_USERNAME=

# Database password. Locally any value (avoid backslashes); on Supabase, the project's database password.
DB_PASSWORD=
