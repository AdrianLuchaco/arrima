#!/bin/sh
# Blocks the commit if the staged changes contain anything that looks like a secret.
# Enabled once per clone with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit aborted." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
